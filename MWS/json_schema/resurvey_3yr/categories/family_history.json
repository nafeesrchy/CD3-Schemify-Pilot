  "$id": "https://schemas.example.org/cd3-mws-pilot/resurvey_3yr/categories/family_history.json",
  "title": "MWS 3-year resurvey — Family History",
  "description": "Family history of specific health conditions in the participant's mother and father, reported at the 3-year resurvey. 13 conditions asked of both parents, plus prostate cancer asked of the father only. All fields are independent checkbox-style items with no gating field -- steward confirmed no relationship to parental_mortality's F1MALIVE (family history of a condition is not tied to whether the parent is currently alive).",
  "type": "object",
  "x-variable-group": "family_history",
  "properties": {
    "F1MHDIS": {
      "title": "Family history (mother): heart disease",
      "oneOf": [
        { "const": 1, "title": "Yes" },
        { "$ref": "../../common/defs.json#/$defs/missing_numeric" }
      ],
      "$comment": "Checkbox-style: the source documents only '1=Yes', no '2=No', and no gating field applies -- any non-1 value is generic missing_numeric. Available on every questionnaire version."
    },
    "F1FHDIS": {
      "title": "Family history (father): heart disease",
      "oneOf": [
        { "const": 1, "title": "Yes" },
        { "$ref": "../../common/defs.json#/$defs/not_on_questionnaire" },
        { "$ref": "../../common/defs.json#/$defs/missing_numeric" }
      ],
      "$comment": "Checkbox-style, same as F1MHDIS, plus its own version-gated -1='Not on questionnaire' code (No on 9903/9907, Yes on 9909/0012) -- every one of the 14 father fields in this category carries this same code, cleanly matching its own version-availability."
